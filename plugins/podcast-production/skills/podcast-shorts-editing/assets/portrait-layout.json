    "camera_audio_enabled": false,
    "set_source_start_before_final_trims": true,
    "source_span_wide_cover_seconds": 0.8,
    "speaker_handoff_wide_seconds_each_side": 0.35,
    "cover_note": "Use verified synchronized wide from the owning source span; constrain ranges to available kept material and adjust editorially.",
    "speaker_turn_audio_label_when_shared": "SHARED MIX"
